{
  "name": "sellflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:studio": "prisma studio",
    "pilot:seed": "tsx scripts/seed-pilot.mjs",
    "verify": "node scripts/verify-api.mjs",
    "test:e2e": "node scripts/verify-api.mjs",
    "test:e2e:clean": "node scripts/test-e2e-clean.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "validate:register": "node scripts/validate-security-register.mjs",
    "deploy": "bash scripts/deploy.sh",
