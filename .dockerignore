# Keep the build context small and secrets out of the image layers.
node_modules
.next
.next/**/*
out
build

.git
.gitignore
.freebuff
.cloud-attachments

# Secrets — SESSION_SECRET must never be baked into an image.
.env
.env.*
!.env.production.example

# Local databases and volume data
prisma/*.db
prisma/*.db-journal
prisma/data

# Host-only tooling and docs (the pilot seeder is needed by the pilot image)
scripts/*
!scripts/seed-pilot.mjs
# The pilot image also runs the backup against the same bind-mounted database.
!scripts/backup-sqlite.mjs
templates
*.md
tsconfig.tsbuildinfo
next-env.d.ts
*.log
