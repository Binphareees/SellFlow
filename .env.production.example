# SellFlow — production environment
#
# Copy this file to `.env.production` (or inject the same keys through your
# host's secret manager) and replace every placeholder before starting the
# server. Never commit the filled-in file: `.env*` is git-ignored.
#
#   cp .env.production.example .env.production
#   npm run build && NODE_ENV=production npm run start
#
# Values marked PUBLIC are compiled into the browser bundle by Next.js — they
# must never hold a secret.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Next.js runs its production server with NODE_ENV=production. Set explicitly
# so `next start` cannot silently run in another mode.
NODE_ENV="production"

# Port the Node server binds to. `next start -p 3000` reads this at runtime.
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Prisma/SQLite connection string. Relative paths are resolved from the
# `prisma/` directory (where schema.prisma lives), so this creates
# `prisma/data/prod.db`. Point it at a dedicated volume, back that file up
# nightly, and keep it out of the repo (already git-ignored).
DATABASE_URL="file:./data/prod.db"

# ---------------------------------------------------------------------------
# Sessions (REQUIRED — the server refuses to start a session without it)
# ---------------------------------------------------------------------------

# 32 random bytes, base64 encoded. Used to hash session tokens and IP hashes at
# rest; rotating it signs every user out (sessions become unverifiable).
#
#   openssl rand -base64 32
#
# The app throws "SESSION_SECRET must be set in production" if this is missing
# or shorter than 16 characters.
SESSION_SECRET=""

# How long a session stays valid. Sessions are revoked server-side on logout,
# so lowering this is a safe way to shorten the dwell time of a stolen cookie.
SESSION_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------------
# Public app identity (PUBLIC — no secrets here)
# ---------------------------------------------------------------------------

# Canonical origin of the deployment: scheme + host, no trailing slash.
# Used for metadataBase, canonical/OpenGraph URLs and the PWA manifest.
NEXT_PUBLIC_APP_URL="https://app.example.com"

# Product name shown in page titles, the installed-app name and the UI shell.
NEXT_PUBLIC_APP_NAME="SellFlow"

# ISO-4217 code for money formatting. All amounts are stored as integer minor
# units (kobo), so this only changes how they are displayed.
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"

# ---------------------------------------------------------------------------
# Sign-in abuse limits (S-05)
# ---------------------------------------------------------------------------

# Failed password attempts allowed per normalized email before that account is
# temporarily locked. Unknown emails are throttled identically, so the response
# does not reveal whether an account exists.
MAX_AUTH_ATTEMPTS=5

# Failed password attempts allowed from one validated source IP across all
# accounts. Higher than the account limit so a shared office/NAT address is not
# locked as quickly as a single targeted account.
MAX_AUTH_IP_ATTEMPTS=20

# How long the counters run before an old window is reset, and how long a
# temporary lock lasts. Both are capped at 24 hours by the application.
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# How long throttle rows are retained for cleanup, and the hard row cap.
# Cleanup runs after failed logins; active locks are removed last.
AUTH_THROTTLE_RETENTION_SECONDS=86400
AUTH_THROTTLE_MAX_ROWS=50000

# ---------------------------------------------------------------------------
# Trusted reverse proxy (optional; leave empty unless one is configured)
# ---------------------------------------------------------------------------

# This app does not trust X-Forwarded-For or X-Real-IP by default. To record a
# real client IP behind a proxy, set a long random secret here and configure the
# proxy to:
#   1. strip any client-supplied x-sellflow-trusted-proxy, x-forwarded-for and
#      x-real-ip headers,
#   2. add x-sellflow-trusted-proxy: <this value>, and
#   3. append the real client address to x-forwarded-for.
# The app uses the rightmost validated X-Forwarded-For entry and ignores the
# header entirely when this secret is empty or does not match. Only one trusted
# proxy hop is supported.
TRUSTED_PROXY_SECRET=""
