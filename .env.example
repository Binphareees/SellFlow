DATABASE_URL="file:./dev.db"
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Transactional email (Resend). Never commit the key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SellFlow Security <security@sellflow.shop>"
RESEND_REPLY_TO=support@sellflow.shop

# Sign-up attempts allowed from one validated source IP within the auth window
# before registration is locked. Kept high (default 30) because shared mobile
# and market networks put many real customers behind one address.
MAX_REGISTRATION_IP_ATTEMPTS=30
